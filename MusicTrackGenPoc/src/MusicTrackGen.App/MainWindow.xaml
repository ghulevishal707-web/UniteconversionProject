<Window x:Class="MusicTrackGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Track Generator — Proof of Concept"
        Height="760" Width="1180" MinHeight="620" MinWidth="960"
        FontFamily="Segoe UI" FontSize="13" Background="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>

        <!-- ================= header ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="18,12">
            <StackPanel>
                <TextBlock Text="Music Track Generator" Foreground="White"
                           FontSize="19" FontWeight="SemiBold" />
                <TextBlock Foreground="#B9C6DC" FontSize="12" Margin="0,2,0,0"
                           Text="Proof of Concept · English · Marathi · Hindi · Punjabi · male / female / child voice" />
            </StackPanel>
        </Border>

        <!-- ================= status bar ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Width="220" Height="10" Minimum="0" Maximum="100"
                             Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <TabControl Margin="10" BorderThickness="1" BorderBrush="{StaticResource PanelBorder}">

            <!-- ============================================================ GENERATE -->
            <TabItem Header="Generate">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- choices -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="What should it generate?" Style="{StaticResource H1}" />

                            <TextBlock Text="Language" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />

                            <TextBlock Text="Singer voice" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding VoiceTypes}" SelectedItem="{Binding SelectedVoice}" />

                            <TextBlock Text="Mood" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Moods}" SelectedItem="{Binding SelectedMood}" />

                            <TextBlock Text="Track length" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding LengthPresets}"
                                      SelectedItem="{Binding SelectedLengthPreset}" />

                            <StackPanel Visibility="{Binding IsCustomLength, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Custom length:" />
                                    <Run Text="{Binding CustomLengthSeconds, StringFormat={}{0:0} s}" />
                                </TextBlock>
                                <Slider Minimum="15" Maximum="300" TickFrequency="15" IsSnapToTickEnabled="True"
                                        Value="{Binding CustomLengthSeconds}" />
                            </StackPanel>

                            <TextBlock Text="Lyrics" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="From the built-in phrase bank"
                                         IsChecked="{Binding UseOwnLyrics, Converter={StaticResource InverseBool}}"
                                         GroupName="LyricSource" Margin="0,0,0,4" />
                            <RadioButton Content="I'll paste my own" IsChecked="{Binding UseOwnLyrics}"
                                         GroupName="LyricSource" Margin="0,0,0,6" />
                            <TextBox Text="{Binding UserLyrics}" AcceptsReturn="True" Height="70"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding UseOwnLyrics}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10">
                                <Run Text="One line per phrase. Script for this language:" />
                                <Run Text="{Binding ScriptName}" FontWeight="SemiBold" />
                            </TextBlock>

                            <CheckBox Content="Render sung vocals" IsChecked="{Binding RenderVocals}"
                                      Margin="0,0,0,10" />

                            <TextBlock Text="Seed  (blank = a new track every time)"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SeedText}" FontFamily="Consolas" Padding="4,3" />
                                <Button Grid.Column="1" Content="Clear" Command="{Binding NewSeedCommand}"
                                        Margin="6,0,0,0" Padding="10,3" />
                            </Grid>

                            <Button Content="G E N E R A T E" Command="{Binding GenerateCommand}"
                                    Style="{StaticResource PrimaryButton}" Height="44" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- result -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Result" Style="{StaticResource H1}" />

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ResultDetails}" Style="{StaticResource Mono}" />
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="▶  Play" Command="{Binding PlayCommand}"
                                        Style="{StaticResource PrimaryButton}" Width="110" />
                                <Button Content="Stop" Command="{Binding StopCommand}" Padding="14,8" Margin="8,0,0,0" />
                                <Button Content="Save as…" Command="{Binding SaveAsCommand}" Padding="14,8" Margin="8,0,0,0" />
                                <Button Content="Open output folder" Command="{Binding OpenOutputFolderCommand}"
                                        Padding="14,8" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="Style profile in use" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Card}">
                                <TextBlock Text="{Binding ProfilePreview}" Style="{StaticResource Mono}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ LIBRARY -->
            <TabItem Header="Library">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Generated tracks" Style="{StaticResource H1}" />
                    <TextBlock Grid.Row="1" Text="{Binding CatalogSummary}" Style="{StaticResource Hint}"
                               Margin="0,0,0,10" />

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" FontSize="12"
                              AlternatingRowBackground="#FAFAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Width="130"
                                                Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm}" />
                            <DataGridTextColumn Header="Language" Width="80" Binding="{Binding Language}" />
                            <DataGridTextColumn Header="Voice" Width="70" Binding="{Binding VoiceType}" />
                            <DataGridTextColumn Header="Mood" Width="90" Binding="{Binding MoodTag}" />
                            <DataGridTextColumn Header="Length" Width="65"
                                                Binding="{Binding ActualLengthSeconds, StringFormat={}{0:0.0} s}" />
                            <DataGridTextColumn Header="Key" Width="110" Binding="{Binding KeyDescription}" />
                            <DataGridTextColumn Header="BPM" Width="60"
                                                Binding="{Binding Bpm, StringFormat={}{0:0.0}}" />
                            <DataGridTextColumn Header="Tuning" Width="260" Binding="{Binding TuningDescription}"
                                                FontFamily="Consolas" />
                            <DataGridTextColumn Header="Seed" Width="140" Binding="{Binding SeedHex}"
                                                FontFamily="Consolas" />
                            <DataGridTextColumn Header="Fingerprint" Width="110"
                                                Binding="{Binding ShortFingerprint}" FontFamily="Consolas" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="▶  Play selected" Command="{Binding PlaySelectedCommand}"
                                Style="{StaticResource PrimaryButton}" Width="150" />
                        <Button Content="Regenerate from seed" Command="{Binding RegenerateCommand}"
                                Padding="14,8" Margin="8,0,0,0" />
                        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"
                                Padding="14,8" Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Text="Regenerate re-renders the track from its seed and reports whether the output is byte-identical." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ TRAIN -->
            <TabItem Header="Train">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0" IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Train on your own music" Style="{StaticResource H1}" />

                        <TextBlock Text="Tag the files you are about to add" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding TrainLanguage}" />
                        <ComboBox ItemsSource="{Binding Moods}" SelectedItem="{Binding TrainMood}" />

                        <TextBlock Text="Provenance / licence note" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding LicenceNote}" TextWrapping="Wrap" Height="46"
                                 AcceptsReturn="True" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Recorded per file. The app learns from whatever you add here, so only add audio you have the rights to use." />

                        <Button Content="+  Add songs…" Command="{Binding AddSongsCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" />
                        <Button Content="+  Add a whole folder…" Command="{Binding AddFolderCommand}"
                                Padding="14,8" Margin="0,0,0,14" />

                        <Separator Margin="0,0,0,14" />

                        <TextBlock Text="Step 1 — measure the audio" Style="{StaticResource FieldLabel}" />
                        <Button Content="Analyse tracks" Command="{Binding AnalyseCommand}"
                                Padding="14,8" Margin="0,0,0,10" />

                        <TextBlock Text="Step 2 — turn measurements into style profiles"
                                   Style="{StaticResource FieldLabel}" />
                        <Button Content="Build style profiles" Command="{Binding BuildProfilesCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" />

                        <Button Content="Cancel running job" Command="{Binding CancelJobCommand}"
                                Padding="14,6" Margin="0,0,0,10" />
                        <Button Content="Remove selected reference" Command="{Binding RemoveReferenceCommand}"
                                Padding="14,6" />

                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                   Text="Style training is CPU-only and takes seconds per song. Neural voice training is a separate, optional phase and is not part of this build." />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource Hint}" Margin="0,0,0,8" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding References}"
                                  SelectedItem="{Binding SelectedReference}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" RowHeaderWidth="0" FontSize="12"
                                  AlternatingRowBackground="#FAFAFB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Width="220" Binding="{Binding Title}" />
                                <DataGridTextColumn Header="Language" Width="80" Binding="{Binding Language}" />
                                <DataGridTextColumn Header="Mood" Width="90" Binding="{Binding MoodTag}" />
                                <DataGridTextColumn Header="Length" Width="70"
                                                    Binding="{Binding DurationSeconds, StringFormat={}{0:0} s}" />
                                <DataGridTextColumn Header="State" Width="80" Binding="{Binding State}" />
                                <DataGridTextColumn Header="Licence" Width="180" Binding="{Binding LicenceNote}" />
                                <DataGridTextColumn Header="Error" Width="*" Binding="{Binding Error}"
                                                    Foreground="#B02020" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="Job log" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
                            <TextBox Text="{Binding TrainLog}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ SETTINGS -->
            <TabItem Header="Settings">
                <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Vocal engine" Style="{StaticResource H1}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding VocalEngineName}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding VocalEngineNotes}" Style="{StaticResource Hint}"
                                           Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Hint}">
                                    <Run Text="Languages:" FontWeight="SemiBold" />
                                    <Run Text="{Binding SupportedLanguages}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="This engine synthesises the voice directly from a formant model, so it needs no Windows language packs — all four languages sing equally well. The trade is that it sounds synthetic and sings vowels with consonant onsets rather than fully articulated words." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Folders" Style="{StaticResource H1}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Workspace" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WorkspaceRoot, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="11" Margin="0,0,0,10" />
                                <TextBlock Text="Generated tracks" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GeneratedFolder, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="11" Margin="0,0,0,10" />
                                <Button Content="Open output folder" Command="{Binding OpenOutputFolderCommand}"
                                        Padding="14,6" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Known limitations of this build" Style="{StaticResource H1}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="• Vocals are synthetic by design. They are on pitch and in time, and they do not sound like a human singer." />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="• The analyser reads uncompressed PCM .wav only. Convert mp3 / m4a before adding them on the Train tab." />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="• Key detection can land on a neighbouring or rotationally-equivalent key; scale content is recovered reliably, the tonic less so." />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="• Lyrics are assembled from a phrase bank, not written. No language model is involved." />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="• 4/4 only, one tempo per track. Generated audio is machine-made and should not be published commercially without review." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MusicTrackGen.App</RootNamespace>
    <AssemblyName>MusicTrackGen.App</AssemblyName>
    <ApplicationTitle>Music Track Generator PoC</ApplicationTitle>

    <!-- Lets the Windows desktop app be compiled from a non-Windows build agent.
         It changes nothing about the produced binary: the output still runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Framework-dependent by default; publish.ps1 also offers a self-contained build. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicTrackGen.Core\MusicTrackGen.Core.csproj" />
  </ItemGroup>

</Project>
